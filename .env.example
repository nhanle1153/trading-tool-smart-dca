# TD-0197 (R10, api-integration-rules.md) — chỉ TÊN biến, KHÔNG giá trị
# thật. Bản có giá trị thật là `.env.binance` (đã .gitignore, KHÔNG BAO
# GIỜ commit — xem .gitignore dòng 20-22).
#
# Chưa có code nào đọc hai biến này ở D0-PRE/D4 (chỉ endpoint public,
# không cần key — xem provider-map.md). Sẽ cần khi entrypoint đặt lệnh
# thật được viết ở D3.5+ (xem TASKS.md, "Việc đã biết là sẽ có, chưa mở"
# → D10–D12).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# TD-0209 — kênh cảnh báo heartbeat/idle (src/tool_d/ops/telegram_client.py).
# Watchdog CHƯA nối vào tiến trình thật (D10-D12 chưa mở) — chỉ hàm thuần
# đã tồn tại, đọc qua ENV khi cần (không qua tool_d_config.yaml, N4).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TD-0241 (DR-D11-03) — Risk Supervisor tự xác thực vào REST API điều
# khiển của CHÍNH Freqtrade cục bộ (POST /api/v1/stop) khi LIQUIDATED/
# breaker dung_han. Đọc bởi src/tool_d/ops/risk_supervisor_daemon.py.
# 🔴 PHẢI khớp ĐÚNG giá trị với username/password mà Freqtrade tự đọc qua
# FREQTRADE__API_SERVER__USERNAME/PASSWORD bên dưới — hai cặp biến khác
# tên (một cặp Freqtrade tự đọc, một cặp daemon của ta tự đọc) nhưng PHẢI
# cùng giá trị, chỉ dùng khi truyền thêm
# `-c config/freqtrade/config.risk_supervisor.json` (D11 setup, chưa mở).
FREQTRADE_API_USERNAME=
FREQTRADE_API_PASSWORD=

# Freqtrade tự đọc ba biến này (cơ chế env-var override chuẩn của chính
# nó, xem DR-D11-03 §2.3) khi chạy VỚI config.risk_supervisor.json —
# KHÔNG đọc bởi code của ta. FREQTRADE__API_SERVER__USERNAME/PASSWORD
# phải khớp đúng hai biến FREQTRADE_API_USERNAME/PASSWORD ở trên.
FREQTRADE__API_SERVER__USERNAME=
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=

# ── TD-0384 (DR-D10-02) — bộ chạy D10, TIỀN THẬT. Các biến dưới đây đặt trong file RIÊNG `.env.d10` ở gốc repo
# (đã .gitignore qua `.env.*`), KHÔNG đặt trong file này. Compose nạp `.env.d10` cho ba service profile `d10`.
#   BINANCE_API_KEY / BINANCE_API_SECRET        — key TÀI KHOẢN PHỤ (IP whitelist bật, rút/chuyển tiền tắt — máy tự kiểm)
#   TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID       — bot Telegram RIÊNG của D10 (KHÔNG dùng lại bot dry-run: hai Freqtrade
#                                                 chung một token tranh getUpdates)
#   FREQTRADE_API_USERNAME / FREQTRADE_API_PASSWORD          — Risk Supervisor tự xác thực vào control API
#   FREQTRADE__API_SERVER__USERNAME / __PASSWORD / __JWT_SECRET_KEY — cùng giá trị cặp trên; JWT ≥ 32 ký tự
